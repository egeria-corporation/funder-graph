# funder-graph environment configuration
#
# Copy to .env and edit. Every variable here is OPTIONAL. funder-graph queries
# the published public dataset with no credentials of any kind.
#
# .env is gitignored. Never commit a real key.

# ---------------------------------------------------------------------------
# Optional: live opportunity enrichment from OpenGrants
# ---------------------------------------------------------------------------
# With a key set, `funder-graph funder <ein>` additionally shows currently open
# opportunities from that funder, marked "— live from OpenGrants". Without it,
# every command works exactly as documented and nothing nags you.
# Get a key from the OpenGrants Developer Dashboard: https://opengrants.io
OPENGRANTS_API_KEY=
OPENGRANTS_API_BASE=https://qnoicxojartltrownmal.supabase.co/functions/v1/

# ---------------------------------------------------------------------------
# Optional: which published dataset to query
# ---------------------------------------------------------------------------
# Base URL of the published Parquet dataset.
FUNDER_GRAPH_DATA_URL=https://data.opengrants.io/funder-graph

# Pin a dataset version for reproducible analysis. Empty means "latest", which
# moves every month. Pin this for anything you will be asked to reproduce.
FUNDER_GRAPH_DATASET_VERSION=

# Local cache directory for Parquet footers and query results.
FUNDER_GRAPH_CACHE_DIR=~/.cache/funder-graph

# ---------------------------------------------------------------------------
# Pipeline only — not needed to query the published dataset
# ---------------------------------------------------------------------------
# These are used by `funder-graph build` and by the publish job. Contributors
# working on parsing or matching do not need them; the sampled build works
# without any of it.

# Where the raw IRS corpus is downloaded and extracted to. Plan for hundreds of
# gigabytes if you are building the full corpus.
FUNDER_GRAPH_WORK_DIR=./build

# Identify yourself to the IRS and ProPublica servers. Be a good citizen.
FUNDER_GRAPH_USER_AGENT=funder-graph/0.1 (+https://github.com/egeria-corporation/funder-graph)

# Cloudflare R2 credentials for publishing a release. Only the maintainer's
# release job needs these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=funder-graph
R2_PUBLIC_BASE=https://data.opengrants.io/funder-graph
