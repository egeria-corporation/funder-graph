# Normalize line endings. CI runs on Linux; development happens on Windows and macOS.
# Without this, a Windows checkout can commit CRLF into source and lint fails only in CI.
* text=auto eol=lf

# Binary and fixture data: never touch.
*.png binary
*.zip binary
*.parquet binary
*.sqlite binary
*.zst binary

# Vendored upstream files are checksummed in data/upstream-pins.toml. Any end-of-line rewrite
# on checkout silently breaks every pin on a fresh clone, so git must never touch these bytes.
data/concordance/** -text
